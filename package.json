{
    "name": "queue-management-root",
    "version": "1.0.0",
    "private": true,
    "workspaces": [
        "frontend",
        "backend"
    ],
    "scripts": {
        "install:all": "npm install && npm install -w frontend && npm install -w backend",
        "dev:frontend": "npm run dev -w frontend",
        "dev:backend": "npm run dev -w backend",
        "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\""
    },
    "devDependencies": {
        "concurrently": "^9.1.0"
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "exceljs": "^4.4.0",
        "express": "^5.2.1",
        "jsonwebtoken": "^9.0.3",
        "morgan": "^1.10.1",
        "node-cron": "^4.2.1",
        "nodemailer": "^7.0.12",
        "socket.io": "^4.8.3",
        "uuid": "^13.0.0"
    }
}
